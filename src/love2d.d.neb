    function newImage(compressedImageData: CompressedImageData, settings: { dpiscale: number | nil, linear: boolean | nil, mipmaps: boolean | nil } | nil): Image
    --- Creates a new specifically formatted image.
    --- In versions prior to 0.9.0, LÖVE expects ISO 8859-1 encoding for the glyphs string.
